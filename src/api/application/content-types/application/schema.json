{
  "kind": "collectionType",
  "collectionName": "applications",
  "info": {
    "singularName": "application",
    "pluralName": "applications",
    "displayName": "Application"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "email": {
      "type": "email",
      "required": true
    },
    "consent": {
      "type": "boolean",
      "required": true
    },
    "applicationStatus": {
      "type": "enumeration",
      "required": true,
      "default": "new",
      "enum": [
        "new",
        "processing",
        "completed",
        "cancelled"
      ]
    }
  }
}
